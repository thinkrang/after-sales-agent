# 复制成 .env 后填入真实值：
#   cp .env.example .env
#
# .env 已被 .gitignore 排除，不要提交真实密钥。

# DeepSeek API Key（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-your-key-here

# Bearer token 签名密钥。生产环境必须使用随机长字符串，例如：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-a-random-secret

# 本地演示用户（密码 demo1234）。生产环境设为 0 并接入正式身份源。
AUTH_SEED_DEMO_USERS=1

# 可选：运行态 SQLite 目录。Docker Compose 已设置为 /app/data。
# AGENT_DATA_DIR=./data
