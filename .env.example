# 复制成 .env 后填入真实值：
#   cp .env.example .env
#
# .env 已被 .gitignore 排除，不要提交真实密钥。

# DeepSeek API Key（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-your-key-here

# Bearer token 签名密钥。生产环境必须使用随机长字符串，例如：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-a-random-secret

# 本地演示用户（密码 demo1234）。生产环境设为 0 并接入正式身份源。
AUTH_SEED_DEMO_USERS=1

# 可选：为模拟商家回调配置租户密钥。每个租户使用不同值，默认不接收回调。
# VOUCHER_MERCHANT_KEYS='{"acme":"replace-with-a-unique-random-key"}'

# 自动恢复计划中的可运行步骤；每 2 秒扫描，等待审批时不调用模型。
# 多进程可共同扫描，使用 SQLite 抢占与业务幂等；单机部署范围。
PLAN_WORKER_ENABLED=1

# 可选：运行态 SQLite 目录。Docker Compose 已设置为 /app/data。
# AGENT_DATA_DIR=./data
# 可选：隔离验收知识索引与上传文件，默认仍使用项目内目录。
# AGENT_VECTOR_DB_DIR=./work/vector_db
# AGENT_UPLOAD_DIR=./work/uploads
