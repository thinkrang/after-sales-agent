{
  "id": "mixed-after-sales-reply-holdout-v3",
  "protocol": "mixed-reply-holdout-v2",
  "cases": [
    {
      "id": "confirm_low_risk_and_check_pending_voucher",
      "seed_dispute": "V400",
      "turns": [
        {
          "text": "A300 的衣服穿不上，尺码不合适，麻烦帮我把退款单建上。还有我之前给 V400 留的核销申诉，今天还要去重新填吗？",
          "tickets": [["A300", "pending_approval", "尺码不合适", "customer"]],
          "voucher": ["V400", "wait_review", "missing_source"],
          "assertions": {
            "order_request_submitted": true,
            "order_customer_must_confirm": true,
            "order_supervisor_must_approve": false,
            "order_refund_already_paid": false,
            "voucher_wait_for_review": true,
            "voucher_submit_required": false
          },
          "rubric": "订单须本人确认，券的争议已经提交，等待复核即可。两件事各有各的状态。"
        }
      ]
    },
    {
      "id": "submit_after_reason_arrives",
      "turns": [
        {
          "text": "A400 那单想办退款，你先帮我看看还少什么材料？别急着提交。",
          "tickets": [],
          "voucher": null,
          "assertions": {
            "order_request_submitted": false,
            "order_customer_must_confirm": false,
            "order_supervisor_must_approve": false
          },
          "rubric": "没有提交申请。可提示提供原因，禁止替用户填原因。"
        },
        {
          "text": "补一下刚才 A400 的原因，是质量问题。现在可以提交申请，请给我办到待审核。",
          "tickets": [["A400", "pending_approval", "质量问题", "approver"]],
          "voucher": null,
          "assertions": {
            "order_request_submitted": true,
            "order_customer_must_confirm": false,
            "order_supervisor_must_approve": true,
            "order_refund_already_paid": false
          },
          "rubric": "A400 申请提交后等待主管审批。"
        }
      ]
    },
    {
      "id": "foreign_order_does_not_block_voucher",
      "seed_dispute": "V200",
      "initial_event": "review_eligible",
      "turns": [
        {
          "text": "小票上 A100 那个因为质量问题，帮我提交普通退单。另外 V200 我收到复核通知，券这边下一步该找谁？",
          "tickets": [],
          "voucher": ["V200", "report_review", "status_mismatch"],
          "assertions": {
            "order_request_submitted": false,
            "order_customer_must_confirm": false,
            "order_supervisor_must_approve": false,
            "voucher_contact_support_to_apply": true,
            "voucher_can_apply_in_workbench": false,
            "voucher_refund_already_paid": false
          },
          "rubric": "当前账号无法为 A100 建单，也不应泄露别人的订单信息。V200 支持联系售后申请，链接用于查看复核结论。"
        }
      ]
    },
    {
      "id": "consultation_stays_read_only_beside_new_dispute",
      "turns": [
        {
          "text": "我在 CENTRAL 用 V400，到店时间是 {arrival}，收银那里查不到核销记录，我还没填过争议。A600 普通订单也帮我看看能不能退，我只是提前问问，先不要建退款单。",
          "tickets": [],
          "voucher": ["V400", "guide_dispute", "missing_source"],
          "assertions": {
            "order_request_submitted": false,
            "order_customer_must_confirm": false,
            "order_supervisor_must_approve": false,
            "voucher_submit_required": true,
            "voucher_wait_for_review": false
          },
          "rubric": "A600 仅核对资格。V400 当前需要申请人核对并提交争议，尚未在等复核。"
        }
      ]
    },
    {
      "id": "voucher_reopens_while_order_waits",
      "seed_dispute": "V200",
      "initial_event": "review_eligible",
      "turns": [
        {
          "text": "给 A600 手表提交退款申请，原因是质量问题。然后查一下 V200 核销纠纷处理到哪里，我还没找到领款入口。",
          "tickets": [["A600", "pending_approval", "质量问题", "approver"]],
          "voucher": ["V200", "report_review", "status_mismatch"],
          "assertions": {
            "order_request_submitted": true,
            "order_supervisor_must_approve": true,
            "voucher_contact_support_to_apply": true,
            "voucher_refund_already_paid": false
          },
          "rubric": "A600 等主管。券的复核支持申请，下一步联系售后，尚未退款。"
        },
        {
          "event": "merchant_matches",
          "text": "刚收到商家补交核销凭证的通知。只刷新 V200 的争议进展，别动刚才的手表申请。前面复核说法还有效吗？",
          "tickets": [["A600", "pending_approval", "质量问题", "approver"]],
          "voucher": ["V200", "wait_review", "matching_redemption"],
          "preserve_refund": true,
          "assertions": {
            "voucher_wait_for_review": true,
            "voucher_contact_support_to_apply": false,
            "voucher_submit_required": false
          },
          "rubric": "补录后争议重新进入复核，旧结论已经失效。保持手表申请原样，无需用户重新提交券争议。"
        }
      ]
    }
  ]
}
